+.training-blocks-page { display: grid; gap: 18px; }
+.training-blocks-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 18px; }
+.training-blocks-heading h1 { margin: 0; color: var(--green-950); }
+.training-blocks-heading p:not(.eyebrow) { margin: 7px 0 0; color: var(--muted); }
+.training-blocks-toolbar { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(210px, .55fr) auto; gap: 10px; }
+.training-block-search, .training-block-group-filter { min-width: 0; min-height: 46px; display: flex; align-items: center; gap: 9px; padding: 0 12px; background: #fff; border: 1px solid var(--border); border-radius: 12px; }
+.training-block-search > svg, .training-block-group-filter > svg { width: 19px; flex: 0 0 auto; color: var(--green-700); }
+.training-block-search input, .training-block-group-filter select { width: 100%; min-width: 0; height: 44px; color: var(--green-950); background: transparent; border: 0; outline: 0; }
+.training-block-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+.training-block-card { min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; padding: 16px; background: #fff; border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 6px 20px rgba(15, 62, 38, .05); }
+.training-block-card.inactive { background: #f7f9f8; opacity: .78; }
