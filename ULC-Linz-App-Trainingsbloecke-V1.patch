+.training-block-card-title { min-width: 0; display: flex; align-items: flex-start; gap: 9px; }
+.training-block-status-dot { width: 10px; height: 10px; flex: 0 0 auto; margin-top: 5px; background: var(--green-600); border-radius: 50%; }
+.training-block-card.inactive .training-block-status-dot { background: #88968e; }
+.training-block-card-title > div { min-width: 0; }
+.training-block-card h2 { overflow: hidden; margin: 0; color: var(--green-950); font-size: 1rem; text-overflow: ellipsis; white-space: nowrap; }
+.training-block-card-title p { display: -webkit-box; overflow: hidden; margin: 4px 0 0; color: var(--muted); font-size: .85rem; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
+.training-block-card-meta, .training-block-card-groups { display: flex; flex-wrap: wrap; gap: 6px; }
+.training-block-card-meta span, .training-block-card-groups span { min-height: 25px; display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; color: var(--green-800); background: var(--green-50); border: 1px solid #d9ebe0; border-radius: 999px; font-size: .72rem; font-weight: 800; }
