diff --git a/src/styles/global.css b/src/styles/global.css
index 5b02c2a..c23789c 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1980,3 +1980,126 @@ input:focus-visible {
   width: 17px;
   height: 17px;
 }
+
+/* Trainingsgruppen – regelmäßige Wochentage und Modulzuordnung */
+.group-schedule-fieldset {
+  display: grid;
+  gap: 9px;
+  margin: 0;
+  padding: 13px;
+  border: 1px solid var(--border);
+  border-radius: 13px;
+}
+
+.group-schedule-fieldset legend {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 0 5px;
+  color: var(--green-950);
+  font-weight: 850;
+}
+
+.group-schedule-fieldset legend svg {
+  width: 18px;
+  height: 18px;
+  color: var(--green-700);
+}
+
+.weekday-selector {
+  display: grid;
+  grid-template-columns: repeat(7, minmax(42px, 1fr));
+  gap: 6px;
+}
+
+.weekday-selector button {
+  min-height: 42px;
+  padding: 6px 4px;
+  color: var(--muted);
+  background: #eef3f0;
+  border: 1px solid transparent;
+  border-radius: 9px;
+  cursor: pointer;
+  font-weight: 850;
+}
+
+.weekday-selector button.selected {
+  color: #fff;
+  background: var(--green-700);
+  border-color: var(--green-700);
+}
+
+.group-module-settings {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 9px;
+}
+
+.setting-checkbox {
+  min-width: 0;
+  display: flex;
+  align-items: flex-start;
+  gap: 9px;
+  padding: 11px;
+  color: var(--green-950);
+  background: #f8fbf9;
+  border: 1px solid var(--border);
+  border-radius: 11px;
+  cursor: pointer;
+}
+
+.setting-checkbox input {
+  width: 20px;
+  height: 20px;
+  flex: 0 0 auto;
+  margin-top: 1px;
+  accent-color: var(--green-700);
+}
+
+.setting-checkbox span {
+  min-width: 0;
+  display: grid;
+  gap: 2px;
+}
+
+.setting-checkbox strong {
+  line-height: 1.3;
+}
+
+.setting-checkbox small {
+  color: var(--muted);
+  line-height: 1.35;
+}
+
+.alert.warning {
+  color: #72530e;
+  background: #fff7df;
+  border-color: #e7d18e;
+}
+
+.compact-alert {
+  padding: 9px 11px;
+  font-size: 0.83rem;
+}
+
+@media (max-width: 700px) {
+  .group-module-settings {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 520px) {
+  .group-schedule-fieldset {
+    padding: 10px;
+  }
+
+  .weekday-selector {
+    gap: 4px;
+  }
+
+  .weekday-selector button {
+    min-height: 40px;
+    padding: 4px 2px;
+    font-size: 0.75rem;
+  }
+}
