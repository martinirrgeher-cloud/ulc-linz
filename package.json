{
  "name": "ulc-linz-app-v2",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "supabase:start": "npx --yes supabase@2.109.1 start",
    "supabase:stop": "npx --yes supabase@2.109.1 stop",
    "supabase:reset": "npx --yes supabase@2.109.1 db reset",
    "supabase:types:local": "npx --yes supabase@2.109.1 gen types typescript --local > src/types/database.generated.ts",
    "supabase:db:push": "npx --yes supabase@2.109.1 db push",
    "supabase:functions:deploy": "npx --yes supabase@2.109.1 functions deploy invite-member"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
