{
  "name": "ulc-linz-app-v2",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "supabase:start": "npx --yes supabase@2.109.1 start",
    "supabase:stop": "npx --yes supabase@2.109.1 stop",
    "supabase:reset": "npx --yes supabase@2.109.1 db reset",
    "test:database": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-database-tests.ps1",
    "test:database:sql": "npx --yes supabase@2.109.1 test db",
    "supabase:types:local": "npx --yes supabase@2.109.1 gen types typescript --local > src/types/database.generated.ts",
    "supabase:db:push": "npx --yes supabase@2.109.1 db push",
    "supabase:functions:deploy": "npx --yes supabase@2.109.1 functions deploy invite-member",
    "package-a:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-package-a.ps1",
    "test:smoke": "node --test scripts/smoke-test.mjs",
    "verify": "npm run typecheck && npm run test:smoke",
    "check:migrations": "node scripts/check-migrations.mjs",
    "ci:quality": "npm run typecheck && npm run test:smoke && npm run check:migrations && npm run check:database-types && npm run check:api-foundation && npm run check:e2e-suite && npm run check:e2e-writing-suite && npm run check:writing-test-isolation && npm run test:writing-test-isolation && npm run check:test-layering && npm run check:test-interactions && npm run check:ui-foundation && npm run check:ui-controls && npm run check:security-headers && npm run check:backup-restore-suite && npm run check:catalog-block-suite && npm run check:help-suite && npm run check:pwa-suite && npm run check:css-architecture && npm run check:release-infrastructure && npm run check:simulation-safety && npm run test:overlay-installer && npm run test:release-approval && npm run test:release-verification && npm run test:start-change && npm run build && npm run check:performance-budget",
    "backup:verify": "node scripts/verify-backup-archive.mjs",
    "check:database-types": "node scripts/check-generated-types.mjs",
    "archive:project": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-project-archive.ps1",
    "check:e2e-suite": "node scripts/check-e2e-suite.mjs",
    "test:e2e:readonly": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-e2e-readonly.ps1",
    "test:local": "npm run release:check && npm run test:e2e:readonly",
    "test:e2e:readonly:ci": "playwright test --config=playwright.config.mjs",
    "check:e2e-writing-suite": "node scripts/check-e2e-writing-suite.mjs",
    "test:e2e:writing": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-e2e-writing.ps1",
    "test:e2e:writing:ci": "playwright test --config=playwright.writing.config.mjs",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:backup-restore-suite": "node scripts/check-backup-restore-suite.mjs",
    "check:catalog-block-suite": "node scripts/check-catalog-block-suite.mjs",
    "check:css-architecture": "node scripts/check-css-architecture.mjs",
    "check:performance-budget": "node scripts/check-performance-budget.mjs",
    "check:help-suite": "node scripts/check-help-suite.mjs",
    "check:pwa-suite": "node scripts/check-pwa-suite.mjs",
    "check:release-infrastructure": "node scripts/check-release-infrastructure.mjs",
    "test:runtime": "node scripts/release/run-runtime-smoke.mjs",
    "test:runtime:ci": "node scripts/release/run-runtime-smoke.mjs",
    "test:runtime:pr": "node scripts/release/run-runtime-smoke.mjs --profile=pr",
    "release:check": "node scripts/release/run-release-check.mjs",
    "release:check:ci": "node scripts/release/run-release-check.mjs",
    "change:start": "node scripts/release/start-change.mjs",
    "change:approve": "node scripts/release/approve-change.mjs",
    "production:mark": "node scripts/release/mark-production.mjs",
    "test:overlay-installer": "node --test scripts/test-overlay-installer.mjs",
    "test:release-approval": "node --test scripts/test-release-approval.mjs",
    "check:simulation-safety": "node scripts/check-simulation-safety.mjs",
    "test:e2e:readonly:pr": "playwright test --config=playwright.config.mjs --project=mobile-390 --retries=0",
    "test:e2e:writing:pr": "playwright test --config=playwright.writing.config.mjs --grep @pr",
    "ci:preview": "npm run typecheck && npm run test:smoke && npm run check:migrations && npm run check:database-types && npm run check:api-foundation && npm run check:e2e-suite && npm run check:e2e-writing-suite && npm run check:writing-test-isolation && npm run check:test-layering && npm run check:test-interactions && npm run check:ui-foundation && npm run check:ui-controls && npm run check:security-headers && npm run check:catalog-block-suite && npm run check:help-suite && npm run check:pwa-suite && npm run check:css-architecture && npm run check:simulation-safety && npm run build && npm run check:performance-budget",
    "test:release-verification": "node --test scripts/test-release-verification.mjs",
    "test:start-change": "node --test scripts/test-start-change.mjs",
    "check:test-interactions": "node scripts/check-test-interaction-architecture.mjs",
    "check:writing-test-isolation": "node scripts/check-writing-test-isolation.mjs",
    "test:writing-test-isolation": "node --test scripts/test-writing-test-isolation.mjs",
    "check:test-layering": "node scripts/check-test-layering.mjs",
    "check:api-foundation": "node scripts/check-api-foundation.mjs",
    "check:ui-foundation": "node scripts/check-ui-foundation.mjs",
    "check:ui-controls": "node scripts/check-ui-controls.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  }
}
