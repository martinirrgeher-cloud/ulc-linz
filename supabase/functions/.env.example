# Nur für lokale Edge-Function-Tests. Niemals echte Secrets einchecken.
# Produktions-Origin muss in APP_ALLOWED_ORIGINS enthalten sein.\nAPP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Nur Fallback, falls eine Serveranfrage keine freigegebene Browser-Origin enthaelt.\nAPP_INVITE_REDIRECT_URL=http://localhost:5173/passwort-neu
